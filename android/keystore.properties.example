# Android Release Signing Properties Template
# Copy this file to android/keystore.properties and fill in your actual credentials.
# Note: android/keystore.properties is ignored by Git and must never be committed.

RELEASE_STORE_FILE=app/pujaguru.keystore
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=pujaguru
RELEASE_KEY_PASSWORD=your_key_password
