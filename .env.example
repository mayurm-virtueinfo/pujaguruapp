# Application Environment Configuration Template
# Copy this file to .env, .env.development, or .env.production and supply appropriate values

ENVIRONMENT=development
BASE_URL=https://dev.puja-guru.com
APP_NAME=Pujaguru-dev

# Razorpay Public Key ID (Client-side checkout identifier)
# e.g., rzp_test_... or rzp_live_...
RAZORPAY_KEY=rzp_test_your_key_id_here

# JSONBin / Mock API Master Key
X_MASTER_KEY=your_x_master_key_here
