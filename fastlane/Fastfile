    UI.success("SAFETY CHECK: Production AAB is stored as an artifact only. NOT uploaded or published to Google Play Console.")
  end
end

platform :ios do
  desc "Build iOS Development application archive and upload to TestFlight (Internal Testing only - NO App Store release)"
  lane :development_testflight do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"]
    version_code = options[:version_code] || ENV["VERSION_CODE"]

    UI.user_error!("version_name is required") if version_name.to_s.strip.empty?
    UI.user_error!("version_code must be a positive integer") unless version_code.to_s =~ /^\d+$/ && version_code.to_i > 0

    UI.header("Building iOS Development TestFlight Archive v#{version_name} (#{version_code})")

    # Optional App Store Connect API Key configuration
    api_key = nil
    if ENV["APP_STORE_CONNECT_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"] && ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      UI.message("Configuring App Store Connect API Key...")
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true,
        in_house: false
      )
    end

    dest_dir = "build/outputs/ipa"
    FileUtils.mkdir_p(dest_dir)
    ipa_filename = "ios-development-#{version_name}-#{version_code}.ipa"

    build_app(
      workspace: "ios/PujaGuruApp.xcworkspace",
      scheme: "PujaGuruApp-Development",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: dest_dir,
      output_name: ipa_filename,
      xcargs: "MARKETING_VERSION=#{version_name} CURRENT_PROJECT_VERSION=#{version_code}"
    )

    ipa_path = "#{dest_dir}/#{ipa_filename}"
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)
    UI.success("Development IPA generated successfully at: #{ipa_path}")

    if api_key
      UI.message("Uploading Development IPA to TestFlight...")
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        skip_submission: true,                      # STRICT REQUIREMENT: Do NOT submit for App Store review
        skip_waiting_for_build_processing: true,    # Non-blocking TestFlight upload
        distribute_external: false                  # Internal testing only
      )
      UI.success("Uploaded Development IPA to TestFlight successfully! (STOPPED: No App Store review or release)")
    else
      UI.important("Notice: App Store Connect API Key not provided. IPA generated as artifact, skipping TestFlight upload.")
    end
  end

  desc "Build iOS Production application archive and upload to TestFlight (Internal Testing only - NO App Store release)"
  lane :production_testflight do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"]
    version_code = options[:version_code] || ENV["VERSION_CODE"]

    UI.user_error!("version_name is required") if version_name.to_s.strip.empty?
    UI.user_error!("version_code must be a positive integer") unless version_code.to_s =~ /^\d+$/ && version_code.to_i > 0

    UI.header("Building iOS Production TestFlight Archive v#{version_name} (#{version_code})")

    # Optional App Store Connect API Key configuration
    api_key = nil
    if ENV["APP_STORE_CONNECT_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"] && ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      UI.message("Configuring App Store Connect API Key...")
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true,
        in_house: false
      )
    end

    dest_dir = "build/outputs/ipa"
    FileUtils.mkdir_p(dest_dir)
    ipa_filename = "ios-production-#{version_name}-#{version_code}.ipa"

    build_app(
      workspace: "ios/PujaGuruApp.xcworkspace",
      scheme: "PujaGuruApp-Production",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: dest_dir,
      output_name: ipa_filename,
      xcargs: "MARKETING_VERSION=#{version_name} CURRENT_PROJECT_VERSION=#{version_code}"
    )

    ipa_path = "#{dest_dir}/#{ipa_filename}"
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)
    UI.success("Production IPA generated successfully at: #{ipa_path}")

    if api_key
      UI.message("Uploading Production IPA to TestFlight...")
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        skip_submission: true,                      # STRICT REQUIREMENT: Do NOT submit for App Store review
        skip_waiting_for_build_processing: true,    # Non-blocking TestFlight upload
        distribute_external: false                  # Internal testing only
      )
      UI.success("Uploaded Production IPA to TestFlight successfully! (STOPPED: No App Store review or release)")
    else
      UI.important("Notice: App Store Connect API Key not provided. IPA generated as artifact, skipping TestFlight upload.")
    end
  end

  desc "Alias for production_testflight"
  lane :testflight do |options|
    production_testflight(options)
  end
end
