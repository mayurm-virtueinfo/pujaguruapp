      UI.important("Notice: Firebase credentials not provided. APK was built successfully as an artifact, skipping distribution.")
    end
  end

  desc "Build Android Production Release AAB (Artifact only - NO Google Play upload)"
  lane :production_aab do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"]
    version_code = options[:version_code] || ENV["VERSION_CODE"]

    UI.user_error!("version_name is required") if version_name.to_s.strip.empty?
    UI.user_error!("version_code must be a positive integer") unless version_code.to_s =~ /^\d+$/ && version_code.to_i > 0

    UI.header("Building Production Release AAB v#{version_name} (#{version_code})")

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "ENVFILE" => ".env.production",
        "VERSION_NAME" => version_name,
        "VERSION_CODE" => version_code
      }
    )

    aab_path = Actions.lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH] || "android/app/build/outputs/bundle/release/app-release.aab"
    UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)

    # Standardized output artifact name
    dest_dir = "build/outputs/bundle"
    FileUtils.mkdir_p(dest_dir)
    target_aab = "#{dest_dir}/app-production-#{version_name}-#{version_code}.aab"
    FileUtils.cp(aab_path, target_aab)

