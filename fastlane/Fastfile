    UI.success("Artifact ready at: #{target_apk}")

    firebase_app_id = options[:firebase_app_id] || ENV["FIREBASE_APP_ID_PROD"]
    firebase_token = options[:firebase_token] || ENV["FIREBASE_TOKEN"]
    service_credentials_file = options[:service_credentials_file] || ENV["FIREBASE_SERVICE_ACCOUNT_PATH"]
    groups = options[:groups] || ENV["FIREBASE_GROUPS"]

    if firebase_app_id && (firebase_token || service_credentials_file)
      UI.message("Distributing Production APK to Firebase App Distribution (App ID: #{firebase_app_id})...")
      git_commit = last_git_commit rescue { short_hash: "ci-build" }
      commit_hash = git_commit ? git_commit[:short_hash] : "ci-build"
      release_notes = "Environment: Production\nVersion: #{version_name} (#{version_code})\nCommit: #{commit_hash}\nWorkflow: Android Production APK\nNote: For QA / Internal Testing only (NOT published to Google Play)"

      firebase_app_distribution(
        app: firebase_app_id,
        apk_path: target_apk,
        firebase_cli_token: firebase_token,
        service_credentials_file: service_credentials_file,
        groups: groups,
