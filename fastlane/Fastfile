default_platform(:android)

platform :android do
  desc "Build Android Development/Staging Release APK and distribute via Firebase App Distribution"
  lane :development_apk do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"]
    version_code = options[:version_code] || ENV["VERSION_CODE"]

    UI.user_error!("version_name is required") if version_name.to_s.strip.empty?
    UI.user_error!("version_code must be a positive integer") unless version_code.to_s =~ /^\d+$/ && version_code.to_i > 0

    UI.header("Building Development Release APK v#{version_name} (#{version_code})")

    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "ENVFILE" => ".env.development",
        "VERSION_NAME" => version_name,
        "VERSION_CODE" => version_code
      }
    )

    apk_path = Actions.lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || "android/app/build/outputs/apk/release/app-release.apk"
    UI.user_error!("APK not found at #{apk_path}") unless File.exist?(apk_path)

    # Standardized output artifact name
    dest_dir = "build/outputs/apk"
    FileUtils.mkdir_p(dest_dir)
    target_apk = "#{dest_dir}/app-development-#{version_name}-#{version_code}.apk"
    FileUtils.cp(apk_path, target_apk)
    UI.success("Artifact ready at: #{target_apk}")

    firebase_app_id = options[:firebase_app_id] || ENV["FIREBASE_APP_ID_DEV"]
    firebase_token = options[:firebase_token] || ENV["FIREBASE_TOKEN"]
    service_credentials_file = options[:service_credentials_file] || ENV["FIREBASE_SERVICE_ACCOUNT_PATH"]
    groups = options[:groups] || ENV["FIREBASE_GROUPS"]

    if firebase_app_id && (firebase_token || service_credentials_file)
      UI.message("Distributing APK to Firebase App Distribution (App ID: #{firebase_app_id})...")
      git_commit = last_git_commit rescue { short_hash: "ci-build" }
      commit_hash = git_commit ? git_commit[:short_hash] : "ci-build"
      release_notes = "Environment: Development/Staging\nVersion: #{version_name} (#{version_code})\nCommit: #{commit_hash}\nWorkflow: Android Development APK"

      firebase_app_distribution(
        app: firebase_app_id,
        apk_path: target_apk,
        firebase_cli_token: firebase_token,
        service_credentials_file: service_credentials_file,
        groups: groups,
        release_notes: release_notes
      )
      UI.success("Successfully uploaded to Firebase App Distribution!")
    else
      UI.important("Notice: Firebase credentials not provided. APK was built successfully as an artifact, skipping distribution.")
    end
  end

  desc "Build Android Development/Staging Release AAB (Artifact only - NO Google Play upload)"
  lane :development_aab do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"]
    version_code = options[:version_code] || ENV["VERSION_CODE"]

    UI.user_error!("version_name is required") if version_name.to_s.strip.empty?
    UI.user_error!("version_code must be a positive integer") unless version_code.to_s =~ /^\d+$/ && version_code.to_i > 0

    UI.header("Building Development Release AAB v#{version_name} (#{version_code})")

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "ENVFILE" => ".env.development",
        "VERSION_NAME" => version_name,
        "VERSION_CODE" => version_code
      }
    )

    aab_path = Actions.lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH] || "android/app/build/outputs/bundle/release/app-release.aab"
    UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)

    # Standardized output artifact name
    dest_dir = "build/outputs/bundle"
    FileUtils.mkdir_p(dest_dir)
    target_aab = "#{dest_dir}/app-development-#{version_name}-#{version_code}.aab"
    FileUtils.cp(aab_path, target_aab)

    UI.success("Artifact ready at: #{target_aab}")
    UI.success("SAFETY CHECK: AAB is stored as an artifact only. NOT uploaded or published to Google Play.")
  end

  desc "Build Android Production Release APK and distribute via Firebase App Distribution"
  lane :production_apk do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"]
    version_code = options[:version_code] || ENV["VERSION_CODE"]

    UI.user_error!("version_name is required") if version_name.to_s.strip.empty?
    UI.user_error!("version_code must be a positive integer") unless version_code.to_s =~ /^\d+$/ && version_code.to_i > 0

    UI.header("Building Production Release APK v#{version_name} (#{version_code})")

    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "ENVFILE" => ".env.production",
